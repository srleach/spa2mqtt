# spa2mqtt settings for deploy/docker-compose.yml.
#
# Copy this file to .env next to docker-compose.yml and edit it:
#   cp .env.example .env
# Docker Compose reads .env twice: to fill ${SPA2MQTT_TAG} in docker-compose.yml, and
# (through env_file) to pass every line below into the container.
# .env holds your MQTT password, so keep it out of git (the repository's .gitignore does).
# Full reference: https://srleach.github.io/spa2mqtt/configuration/

# Image tag to run. "2" follows every 2.x.y release. Pin a full version such as 2.0.0
# to update only when you change this line.
SPA2MQTT_TAG=2

# Address and TCP port of the RS485-to-TCP adapter (for example an EW11A).
SPA_IP=192.168.1.100
SPA_PORT=8899

# Tub definition. List the built-in ones with: docker run --rm ghcr.io/srleach/spa2mqtt:2 spa2mqtt definitions
# VARIANT_DEFINITION is the v1 name of this setting and still works.
SPA_DEFINITION=jacuzzi_j235

# SAFETY: false = receive-only. Buttons and the setpoint show as unavailable in Home Assistant.
# Set true only after the decoded values match the topside. Read the Safety page first.
# If this line is present it overrides spa.transmit in a mounted config.yml, even when empty.
SPA_TRANSMIT=false

# MQTT broker that Home Assistant uses. Leave username and password empty for an open broker.
MQTT_BROKER=192.168.1.7
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=

# DEBUG, INFO, WARNING or ERROR.
LOG_LEVEL=INFO
